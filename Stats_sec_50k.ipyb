        "# New section"
      ],
      "metadata": {
        "id": "J6aJqC6mqK9S"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "0a54d3f1",
        "collapsed": true
      },
      "source": [
        "for index, row in df_max.iterrows():\n",
        "    path = row['path']\n",
        "    print(f\"Path: {path}\")\n",
        "    for node_id in path:\n",
        "        # Find the node in the nodes DataFrame\n",
        "        node_info = nodes[nodes['id'] == node_id]\n",
        "        if not node_info.empty:\n",
        "            # Get the properties and check for 'name' and Tier information\n",
        "            properties = node_info.iloc[0]['properties']\n",
        "            node_name = properties.get('name', 'N/A')\n",
        "            is_tier0 = node_info.iloc[0]['Tier0'] == 1\n",
        "            is_tier1 = node_info.iloc[0]['Tier1'] == 1\n",
        "            is_tier2 = node_info.iloc[0]['Tier2'] == 1\n",
        "            print(f\"  Node ID: {node_id}, Name: {node_name}, Tier0: {is_tier0}, Tier1: {is_tier1}, Tier2: {is_tier2}\")\n",
        "        else:\n",
        "            print(f\"  Node ID: {node_id} not found in nodes DataFrame.\")\n",
        "    print(\"-\" * 20)"
      ],
      "execution_count": null,
      "outputs": []
    },
